@import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700&display=swap');


:root
    --primary-font: "Nunito Sans", sans-serif
    -secondary-font: "Oswald", sans-serif
    --primary-color: #ef5d15
    --secondary-color: #a74a0f
    --light-orange: #FDEFE8
    --black: #202020
    --light-grey: #ddd
    --white: #fff
    --normal: 400
    --semi-bold: 600
    --bold: 700
    
*
    margin:0
    padding: 0

html
    scroll-behavior: smooth
    transition: 720ms linear

body
    position: relative
    overflow--y: scroll
    font-family: var(--primary-font)
    font-weight: var(primary-normal)
    font-size: 16px

.container
    margin: 0 auto
    width: 100%
    max-width: 1440px

.container-full
    width: 100%


.white
    color: white

.header
    font-size: 70px
    font-weight: var(--bold)

.sub-header
    font-size: 35px
    font-weight: var(--medium)

.sub-title
    font-size: 40px
    font-weight: var(--med)
